config_version=5

[application]
config/name="RoxHistory"
config/use_custom_user_dir=true
config/custom_user_dir_name="RoxHistory"
config/version="0.339.347"
config/build_date="2026.11.28"
config/icon="res://assets/app-icon-pioneer.png"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]
PatchBootstrap="*res://patch_test/bootstrap.tscn"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
gl_compatibility/driver.windows="opengl3_angle"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.16, 0.23, 0.16, 1)

[input_devices]
pointing/android/disable_scroll_deadzone=true
pointing/android/enable_pan_and_scale_gestures=false
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[roxhistory]
distribution/full_apk_version="0.339.339"
distribution/reset_patch_channel_enabled=true

inventory/capacity=64

development/settings_entry=true
