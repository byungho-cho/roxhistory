extends RefCounted

const ENTRIES := {
	"0.2.296": ["실험실에서 새봄의 돌칼 근접 공격과 2SP 동작을 개선했습니다. 2SP 피해는 마지막 타격에만 적용됩니다.", "새봄의 원거리 돌팔매에 발사, 돌 파편, 재장전 연출을 보강했습니다.", "스킬 발동 아이콘을 전투원 머리 위에 표시하고 새봄 3SP 아이콘은 강화 효과가 끝날 때까지 남도록 했습니다.", "한결 피격 초상화가 잘려 보이던 문제를 수정했습니다."],
	"0.2.295": ["안드로이드 전체 설치 기준을 새로 잡았습니다. 기존 앱을 삭제하지 않고 덮어 설치하며 저장과 설정을 유지합니다.", "게임 내용은 0.2.294와 동일합니다. 다음 인게임 패치는 0.2.295 설치본을 기준으로 받습니다."],
	"0.2.294": ["실험실: 우람 2SP의 손잡이 고정·타격 뒤 0.7초 유지·묵직한 충격음, 3SP 일반 타격의 거리별 연출과 정확한 받아치기를 구분했습니다.", "새봄 근접 평타를 교체하고 2SP는 네 번째 타격에만 피해가 적용됩니다. 원거리 돌의 출발·도착과 효과음을 맞췄습니다.", "피격 초상화, 쓰러짐의 흑백 표시, 새봄 3SP 지속 숫자와 원거리 시험 시작 체력을 조정했습니다. 일반 사냥은 그대로입니다."],
	"0.2.293": ["1대1 전투 실험실에서 우람 2SP를 제자리 내려찍기와 지면 파동으로 바꾸고, 3SP 받아치기 예고를 앞당겼습니다.", "3대3 받아치기는 실제 두 개체에 집중되며 주변 밝기가 50%로 낮아집니다. 새봄 근거리·원거리 시나리오와 근거리 2SP 아이콘 및 상하단 전투 HUD를 개선했습니다. 일반 사냥은 그대로입니다."],
	"0.2.292": ["1대1 전투 시험장을 TEST44로 갱신했습니다. 우람 방패의 등장과 실제 받아치기 판정을 보정했습니다.", "3대3 시험장의 하단 스킬 조작부를 키우고 배치를 개선했습니다. 일반 사냥 규칙은 그대로입니다."],
	"0.2.291": ["실험실의 1대1 전투를 검수한 TEST42로 교체했습니다. 1대1 전투 시험장에서 충전 버튼으로 스킬을 바로 확인할 수 있습니다.", "우람 받아치기에 새 먼지 연출과 타격음을 반영했습니다. 일반 사냥 SP 규칙은 유지합니다."],
	"0.2.290": ["실험실에 TEST35 사냥 시연을 추가했습니다. 우람과 새봄 전투 이펙트에 최신 온색 보정을 반영했습니다.", "일반 사냥에서 우람과 새봄 연출을 확인할 수 있습니다."],
	"0.2.289": ["일반 사냥에서 한결·우람·새봄의 스킬, 실제 패링과 3SP 연계를 개편했습니다. 새봄의 응원은 범위 안 아군의 공격력을 5초 동안 20% 높입니다.", "1장 최종 사냥에 성체 멧돼지가 등장합니다. 기존 해금과 보상은 유지하고, 전투 광원·체력바·카메라 연출을 개선했습니다."],
	"0.2.288": ["최신 main의 실험실 스킬 이펙트와 준비광 보정을 반영했습니다.", "한결·우람·새봄의 기존 전투 보정과 일반 업데이트의 패치 우선 배포 정책을 유지합니다."],
	"0.2.284": ["본편·실험실의 전투 초상과 스킬 준비 표시를 통일하고 머리 위 이름·체력과 옥구슬 SP를 적용했습니다. 본편의 기존 기술 연결·소비량은 유지합니다.", "한결–꽃사슴 실험실의 연계기 접점 충격파와 짧은 도약 감속·줌, 받아치기 성공 접점의 짧은 감속·줌을 적용했습니다. 기존 피해·판정·충전 규칙은 유지합니다."],
	"0.2.283": ["한결–꽃사슴 1대1 실험실을 공통 3D 전장과 몸 충돌·실제 접촉 판정으로 전환했습니다.", "0070의 효과와 인트로 선택은 유지하고, 본편 및 다른 조합은 기존 방식으로 유지합니다."],
	"0.2.282": ["한결–꽃사슴 실험실의 창 접점·짧은 발 디딤·연계기 방향과 타격 효과를 보정했습니다.", "확정 인트로와 음원 1·2 선택을 적용했습니다. 음악을 바꿔도 영상·효과음은 이어집니다."],
	"0.2.281": ["인트로에 등장 A안과 ‘사냥의 긴장’ 1안 가안을 적용했습니다. 음악과 효과음은 각 사운드 설정을 따르며 영상 시작·반복·앱 복귀 시 시간을 맞춥니다.","한결 대 꽃사슴 실험실의 동시 접근과 평타 교환 변경도 포함합니다. 이전 인트로 원본은 보존합니다."],
	"0.2.280": ["한결 대 꽃사슴 실험실에서 양쪽이 달려 접근한 뒤 가까운 거리에서 평타를 주고받도록 변경했습니다.","서로의 공격 준비와 회복이 겹치도록 평타 흐름을 조정하고, 평타 효과음은 명중 순간에 재생합니다. 본편 전투와 다른 실험실 조합은 유지합니다."],
	"0.2.279": ["실험실 1대1의 평타 준비·회복을 자연스럽게 연결하고, 명중 순간부터 체력바가 부드럽게 줄어들도록 보정했습니다.","한결 평타와 일반 스킬의 실제 창끝을 현재 표적에 맞췄습니다. 기존 피해 간격·피해량과 본편 전투는 유지합니다."],
	"0.2.278": ["실험실 1대1의 일반 스킬을 자동 평타·이동 중에도 초상화로 발동하도록 수정했습니다.","본편 1-1 전투 시작 구도와 카메라를 재사용하고 상단 HUD와 SP 가독성을 개선했습니다. 일시정지/재개는 전투·충전·시간·사망 대기를 함께 멈춥니다."],
	"0.2.277": ["실험실 1대1 전장에 2 SP 일반 스킬 준비광과 3 SP 개별 연계 테두리 효과를 적용했습니다.","초상화는 일반 스킬, 위 아이콘은 개별 연계기를 발동합니다. 리셋 시 SP와 준비 효과를 초기화하며 본편 전투는 유지합니다."],
	"0.2.276": ["모델 테스트 걷기의 이동 거리를 우람 기준으로 통일했습니다. 같은 시간에 우람·한결은 2걸음, 새봄은 3걸음으로 걷습니다."],
	"0.2.275": ["한결·새봄의 걷기 모션 재생 속도를 직전 버전보다 1.5배 높였습니다."],
	"0.2.274": ["모델 테스트 연계기는 개별 즉시 재생·아군 ALL 동시 시작으로 바뀌었습니다. 전체 모션의 연계 구간도 함께 시작합니다.", "실제 전투 연계와 사망 효과는 유지했습니다. 걷기·피격은 최종 GLB 미수령으로 기존 모션을 유지합니다."],
	"0.2.273": ["모델 테스트의 사망 미리보기에 공용 천사·비석과 몬스터 흙먼지·고기 연출을 추가했습니다.", "걷기·피격 최종 GLB는 미수령으로 기존 모션을 유지합니다. 실제 사냥과 보상은 변경하지 않았습니다."],
	"0.2.272": ["RES-050 아군 3종·야생동물 4종의 최신 모델과 리폼 모션을 반영했습니다.", "우람 방패의 반격 겹침 보정을 적용했습니다. 기존 배속과 전투 판정은 유지합니다."],
	"0.2.271": ["미니맵을 아래로 10px, 자원바를 아래로 5px·왼쪽으로 5px 조정했습니다."],
	"0.2.270": ["미니맵과 연결된 설정·지도 아이콘을 위로 약 30px 이동했습니다."],
	"0.2.269": ["자원바를 오른쪽 약 100px, 위로 약 20px 옮겼습니다. 줄인 폭과 숫자 정렬은 유지합니다."],
	"0.2.268": ["자원바 폭과 숫자 정렬을 정리하고 미니맵·설정 아이콘 위치를 조정했습니다.", "모델 테스트 전장을 전체 화면으로 넓히고 뒤로가기를 초상화 줄에 배치했습니다.", "새봄 기본 공격 모션을 기존 대비 1.5배 빠르게 조정하고 게임 재실행 툴팁을 제거했습니다."],
	"0.2.267": ["D0066 신규 모션을 반영하고, 달리기 A/B/C 비교에서 종료되는 문제를 수정했습니다."],
	"0.2.266": ["모델 테스트에 아군 신규 가드·반격·사망과 일반 스킬·연계 스킬을 연결했습니다.", "아군 모두의 연계는 우람 → 새봄 → 한결 순서로 재생합니다.", "야생동물 경량판의 신규 모션과 준비·발동 구간 배속, 사망 연출을 적용했습니다. 기존 전투 판정과 사운드는 유지합니다."],
	"0.2.265": ["한결을 1.2만 폴리곤 경량판으로 통일하고 한결 폴리곤 비교를 단일 보기로 바꿨습니다.", "한결·새봄 달리기 C안을 적용하고 아군 기존 모션의 재생 속도를 조정했습니다. 별도 달리기 A/B/C와 야생동물은 유지됩니다."],
	"0.2.264": ["최신 변경사항을 포함한 전체 APK를 새로 배포했습니다.", "시작 화면과 설정의 APK 링크 복사는 실제 풀버전 배포를 가리키며 이후 패치 버전과 별도로 유지됩니다."],
	"0.2.263": ["초원의 막사·모닥불을 왼쪽으로 옮기고 불꽃과 연기를 다듬었습니다. 멧돼지 등장 중에도 연출이 이어집니다.", "모델 테스트의 한결·새봄에서 달리기 A/B/C를 동시에 비교합니다. 본게임 달리기는 유지합니다."],
	"0.2.262": ["모델 테스트의 몹 모션을 7개 버튼으로 정리하고 사슴·멧돼지의 공격과 스킬을 연결했습니다.", "대상 선택과 배속 버튼을 키우고 루비 재시작을 적용했습니다. 1.25배속은 제거했습니다."],
	"0.2.261": ["모델 테스트에서 한결과 몹 4종의 원본·경량판을 좌우로 동시에 비교합니다.", "모델 위에 축약한 폴리곤 수를 표시하고 모션·배속·재시작·전장뷰·경로를 함께 적용합니다."],
	"0.2.260": ["모델 테스트에 한결과 몹 4종의 경량 A/B 비교를 추가하고 아군 모션 버튼을 정리했습니다.", "초원의 막사와 모닥불을 옮기고 진입·스킵 중에도 불과 연기가 이어집니다.", "인트로 배경 터치 스킵, 펼침 가방 정렬, BGM 기본 믹스를 개선했습니다.", "PCK 다운로드는 데이터가 30초 동안 멈췄을 때만 중단됩니다."],
	"0.2.259": ["기존 실험실 아래에 별도 모델 테스트를 추가했습니다.", "아군·CH1 야생동물 선택과 카테고리별 ALL 비교, 전장뷰·고정 경로를 지원합니다.", "8단계 배속과 모션 재시작을 추가하고 미연결 모션은 비활성으로 표시합니다."],
	"0.2.202": ["촌장집의 양쪽 눈 불꽃이 교차하지 않도록 조정했습니다.", "굴뚝 연기가 위로 퍼지면서 자연스럽게 옅어지도록 다듬었습니다."],
	"0.2.203": ["촌장집 굴뚝 연기가 더 높고 풍성하게 올라옵니다.", "눈 불꽃이 양옆으로 벌어지며 여러 갈래로 일렁입니다."],
	"0.2.204": ["가방 배경에서 바구니와 토기가 잘 보이도록 원화를 교체했습니다.", "여정의 기록과 퀘스트 보상 팝업을 정리했습니다.", "설정과 업데이트 안내에 버전별 패치 노트를 추가했습니다.", "초원 멧돼지는 등장 후 무음 대기 동작을 반복합니다.", "마을 경계 안개에 실험실 전용 5단계 비교를 추가했습니다."],
	"0.2.205": ["경계 안개 실험의 2~5단계에서 흰 차폐를 지면 원화 바깥에만 표시합니다.", "게임 설정 왼쪽 아래 버전을 눌러 현재 패치 노트를 열 수 있습니다."],
	"0.2.206": ["마을 외곽 배경과 안개 사이로 보이는 나무와 바위를 추가했습니다.", "가방을 열 때 배경이 먼저 나타납니다.", "퀘스트 보상과 여정의 기록은 처음 보이는 목록이 위에서부터 나타납니다."],
	"0.2.207": ["마을 바깥이 회녹색 안개로 이어지고 지도 끝에서 화면이 부드럽게 돌아옵니다.", "가방에 다섯 줄을 표시하고 우측 하단에 닫기 버튼을 추가했습니다.", "팝업 닫기 입력 영역을 넓히고 임무·보상 닫기 표시를 키웠습니다.", "패치를 적용한 뒤 변경사항을 한 번 보여주며 설정의 버전에서 다시 볼 수 있습니다."],
	"0.2.208": ["여정의 기록에서 임무를 다섯 개씩 보고 진행 영역을 더 넓게 확인할 수 있습니다.", "임무와 보상 팝업의 전환 효과를 게임 설정과 통일했습니다.", "Windows는 다른 창을 쓰는 동안에도 게임이 진행되며 10분이 지나면 저장 후 종료합니다."],
	"0.2.209": ["마을 안개가 경계 안쪽부터 시작해 모서리를 둥글게 감쌉니다.", "게임 설정의 버전 번호를 더 크고 굵게 표시합니다.", "새 주민의 말풍선 문구를 본문 중앙에 맞췄습니다."],
