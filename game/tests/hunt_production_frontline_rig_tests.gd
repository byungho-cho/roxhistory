extends SceneTree
const Front=preload("res://scripts/hunt_production_frontline_rig.gd")
var failures:=0
func _initialize():call_deferred("run")
func check(c:bool,label:String):
 if not c:failures+=1;push_error(label)
func run():
 var p:=Node2D.new()
 root.add_child(p)
 p.position=Vector2(14,26)
 p.scale=Vector2(.85,.85)
 var h=Front.create("hangyeol")
 h.render_size_factor=.5;p.add_child(h);h.position=Vector2(130,275);h.scale=Vector2(.56,.56);h.set_enabled(true)
 var u=Front.create("uram")
 u.render_size_factor=.5;p.add_child(u);u.position=Vector2(242,278);u.scale=Vector2(.56,.56);u.set_enabled(true)
 for x in [h,u]:
  check(x is HybridCharacter and x.skeleton.get_bone_count()>10,"native authored rig")
  check(x.supports_profile("basic") and x.supports_profile("skill") and x.supports_profile("chain"),"all skill profiles available")
  check(not x.resident_sample("nonsense",0.),"unsupported profile does not silently trigger other pose")
  x.use_training_spear()
  check(x.tool_3d.get_child_count()==0,"no fake training equipment")
  x.animate(.1,Vector2(1,.3),1.4,true,"",0.,false)
  check(x.feet_world().is_equal_approx(x.global_position),"movement owned by parent")
 h.sample_native("basic",.5)
 var a:Vector2=h.spear_tip_world()
 check(h.has_spear_anchor() and a.is_finite() and a.distance_to(h.global_position)>5.,"real bound chipped spear-tip projected")
 h.sample_native("chain",1.55)
 check(h.spear_tip_world().distance_to(a)>1.,"spear tip tracks animated hand")
 h.set_render_zoom(2.)
 check(h.spear_tip_world().is_finite(),"zoom keeps valid spear projection")
 u.sample_native("skill",.8)
 check(u.has_club_anchor() and u.has_shield_anchor() and u.club_head_world().distance_to(u.shield_face_world())>5.,"real separate club and shield projected")
 check(u.shield_direction_world().length()>.9,"shield face directional basis")
 check(u.animator.current_animation=="req047_club_slam","actual native 2SP")
 u.sample_native("chain",.4)
 check(u.animator.current_animation=="parry","actual native 3SP")
 print("Frontline production rig assertions: ",failures)
 quit(int(failures>0))
