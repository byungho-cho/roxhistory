extends "res://tests/building_hold_v056_tests.gd"
func run()->void:
	root.size=Vector2i(1280,800)
	app=load("res://scenes/main.tscn").instantiate();root.add_child(app);await frames()
	app.model=GameState.new(SaveStore.new("user://review0159_%d"%Time.get_ticks_usec()));app.model.start_new();app.model.changed.connect(app.update_hud)
	check(app.model.debug_unlimited_buildings and app.model.debug_unlimited_builders and app.model.debug_fast_build and app.model.debug_show_boundary,"New game development switches all ON")
	app.model.debug_show_boundary=false
	var reloaded:=GameState.new(app.model.store)
	check(not reloaded.debug_show_boundary and reloaded.debug_fast_build,"Existing OFF choice survives reload")
	var state:Dictionary=app.model.state.duplicate(true);state.chief_level=1;state.resident_guide_seen=true;app.model.commit(state)
	app.enter_game();await frames(10)
	var quest:Control=app.stage.get_node("QuestPanel")
	check(Rect2(8,8,224,64).encloses(app.quest_arrow.get_rect()),"Quest fold image keeps 8px margins")
	check(Rect2(8,8,224,64).encloses(app.objective.get_rect()),"Quest title keeps 8px margins")
	check(app.quest_stone.position.x+app.quest_stone.size.x<=232 and app.quest_stone.position.y+app.quest_stone.size.y<=72,"Quest resources fit the background padding")
	app.toggle_quest()
	var folded_bounds:Rect2=app.quest_arrow.get_transform()*Rect2(Vector2.ZERO,app.quest_arrow.size)
	check(quest.size.y==48 and Rect2(8,8,224,32).grow(.1).encloses(folded_bounds),"Collapsed quest contains rotated artwork: %s"%folded_bounds)
	await capture("quest-collapsed")
	app.toggle_quest()
	app.show_development_settings();await frames()
	var scroll:ScrollContainer=app.overlay.find_child("DevelopmentSettingsScroll",true,false)
	check(scroll is DevelopmentSettingsScroll,"Development settings own native touch scroll")
	var settings_before:Dictionary=app.model.state.duplicate(true)
	var at:Vector2=scroll.get_global_rect().get_center()+Vector2(0,70)
	for swipe in 4:
		touch(at,0,true);drag_touch(at-Vector2(0,170),0);touch(at-Vector2(0,170),0,false);await frames()
	var bar:=scroll.get_v_scroll_bar()
	check(scroll.scroll_vertical>=int(bar.max_value-bar.page)-1,"Touch reaches the final settings row")
	var last:Control=app.overlay.find_child("FullResetButton",true,false)
	check(scroll.get_global_rect().encloses(last.get_global_rect()),"Full reset action is visible above the return row")
	check(app.model.state==settings_before,"Scroll does not toggle or reset settings")
	await capture("mobile-settings-bottom")
	app.close_modal();await frames()
	app.world.player.manual_camera=true;app.world.player.zoom_at(Vector2(app.w,app.h)*.5,1.0,app.model.building_position("chief"));await frames()
	check(app.building_menu.show_at(building_point()),"Building menu opens")
	await frames()
	check(app.building_menu.move_button.size.is_equal_approx(Vector2(76.8,76.8)),"Action menu size reduced20 percent")
	var demolish_rect:Rect2=app.building_menu.demolish_button.get_rect()
	check(app.building_menu.close_button.position.x-demolish_rect.end.x>=7.9,"Close button has8px separation from demolish")
	check(app.building_menu.close_button.size.x>=44,"Close touch target remains44px")
	await capture("menu-spacing");app.building_menu.close()
	state=app.model.state.duplicate(true);state.pending_family_count=1;state.resident_guide_seen=false;app.model.commit(state);await frames(10)
	check(app.overlay is CharacterGuide,"First visitor opens full-screen character guide")
	await create_timer(.6).timeout;await frames();await capture("first-visitor-guide")
	app.close_modal();await frames(10)
	check(not app.modal and app.family.bubble.visible,"First visitor guide is not repeated")
	check(GameState.new(app.model.store).state.get("resident_guide_seen",false),"First visitor acknowledgement survives save reload")
	check(app.family.bubble.focus_mode==Control.FOCUS_NONE,"Resident bubble has no focus border")
	check(app.family.bubble.get_meta("semantic_text")==app.family.headline.text and app.family.bubble.size.y<=40,"Resident bubble has one line without condition hints")
	app.family.request();await frames()
	check(not app.modal and app.toast_label.text.contains("움집"),"Capacity requirement appears as toast only after tap")
	await capture("resident-one-line")
	root.size=Vector2i(720,900);await frames(12);app.show_development_settings();await frames()
	scroll=app.overlay.find_child("DevelopmentSettingsScroll",true,false)
	var toggle:CheckBox=app.overlay.find_child("UnlimitedBuildingsToggle",true,false)
	var enabled:bool=toggle.button_pressed
	at=toggle.get_global_rect().get_center()
	touch(at,0,true);drag_touch(at-Vector2(0,180),0);touch(at-Vector2(0,180),0,false);await frames()
	check(app.model.debug_unlimited_buildings==enabled,"Scrolling from a toggle does not activate it")
	bar=scroll.get_v_scroll_bar();scroll.scroll_vertical=int(bar.max_value-bar.page);await frames()
	last=app.overlay.find_child("FullResetButton",true,false)
	check(scroll.get_global_rect().encloses(last.get_global_rect()),"Portrait layout also exposes last setting")
	print(JSON.stringify({"checks":checks,"failures":failures,"touch":"synthetic; Android hardware not tested"}))
	app.queue_free();await frames();quit(0 if failures.is_empty() else 1)
