extends "res://tests/building_hold_v056_tests.gd"
func shot(file:String)->void:
	await frames(3);await RenderingServer.frame_post_draw
	root.get_texture().get_image().save_png("res://reports/v0159-"+file+".png")
func click(at:Vector2)->void:
	mouse(at,MOUSE_BUTTON_LEFT,true);mouse(at,MOUSE_BUTTON_LEFT,false)
func run()->void:
	root.size=Vector2i(1280,720)
	app=load("res://scenes/main.tscn").instantiate();root.add_child(app);await frames()
	app.test_mode=true;app.model=GameState.new(SaveStore.new("user://hud-guide-%d"%Time.get_ticks_usec()));app.model.start_new();app.model.changed.connect(app.update_hud)
	var state:Dictionary=app.model.state.duplicate(true);state.chief_level=1;state.wood=1000;state.stone=1000;state.resident_guide_seen=true;app.model.commit(state)
	app.enter_game();await frames(12)
	app.world.player.manual_camera=true;app.world.player.zoom_at(Vector2(app.w,app.h)*.5,1.1,app.model.building_position("chief"));await frames()
	var price:Dictionary=app.model.building_cost("chief",2)
	app.building_workflow.request_upgrade();await frames()
	var hud:UpgradeConfirmation=app.overlay.get_node("UpgradeConfirmation")
	check(hud.cost_display.amounts[0].text==str(price.wood) and hud.cost_display.amounts[1].text==str(price.stone),"Upgrade shows actual model cost")
	check(hud.find_child("CancelUpgrade",true,false)==null and hud.find_child("CurvedBackground",true,false)==null,"No obsolete panel or X")
	check(hud.cost_display.confirm_button.size==Vector2(60,60),"Confirmation 60px touch target")
	for value in [20,50,100,300,9999,100000]:
		hud.cost_display.update_cost({"wood":value,"stone":value})
		for amount in hud.cost_display.amounts:
			check(amount.get_theme_font("font").get_string_size(amount.text,HORIZONTAL_ALIGNMENT_LEFT,-1,amount.get_theme_font_size("font_size")).x<=amount.size.x,"Cost digits fit without overlap: %d"%value)
	hud.cost_display.update_cost(price)
	var no_materials:Dictionary=app.model.state.duplicate(true);no_materials.wood=0;app.model.commit(no_materials)
	click(hud.cost_display.confirm_button.get_global_rect().get_center());await frames()
	check(not app.modal and not app.model.state.has("chief_upgrade"),"Confirmation rechecks materials without spending")
	no_materials.wood=1000;app.model.commit(no_materials);app.building_workflow.request_upgrade();await frames()
	hud=app.overlay.get_node("UpgradeConfirmation")
	var before:Dictionary=app.model.state.duplicate(true)
	click(hud.get_global_rect().get_center());await frames()
	check(app.modal and app.model.state==before,"Cost body tap does not close or purchase")
	await shot("upgrade")
	click(Vector2(650,120));await frames()
	check(not app.modal and app.model.state==before,"Background dismiss preserves state")
	app.building_workflow.request_upgrade();await frames()
	hud=app.overlay.get_node("UpgradeConfirmation")
	click(hud.cost_display.confirm_button.get_global_rect().get_center());await frames()
	check(not app.building_workflow.confirm_upgrade(2),"Duplicate confirmation cannot charge twice")
	check(app.model.state.has("chief_upgrade"),"Real confirm click starts upgrade")
	check(app.model.state.wood==before.wood-price.wood and app.model.state.stone==before.stone-price.stone,"Correct one-time deduction")
	app.building_workflow.request_cancel_upgrade("chief");await frames()
	check(app.modal,"In-progress cancellation confirmation remains")
	app.building_workflow.confirm_cancel("chief",true);await frames()
	check(app.model.state.wood==before.wood and app.model.state.stone==before.stone,"Cancellation fully refunds")
	app.build_side.select_kind("hut");await frames()
	var at:=free_position("hut");check(at.is_finite(),"Valid placement found")
	app.build_preview.select_position(at,"hut");app.world.player.zoom_at(Vector2(app.w,app.h)*.5,1.1,at);await frames(10)
	check(app.build_preview.cost_display.visible and not app.build_preview.controls.visible,"Build placement uses single shared HUD")
	check(app.build_preview.confirm_button==app.build_preview.cost_display.confirm_button,"Build confirmation uses shared button")
	await shot("placement")
	var current:Dictionary=app.model.state.duplicate(true)
	app.cancel_build_preview();await frames()
	check(not app.build_preview.active() and app.model.state==current,"Existing placement cancel retains data")
	app.build_side.select_kind("hut");app.build_preview.select_position(at,"hut");await frames(5)
	click(app.build_preview.confirm_button.get_global_rect().get_center());await frames()
	check(app.model.construction_jobs().size()==1,"Shared construction confirmation starts job")
	if app.model.construction_jobs().size()==1:
		var uid:=str(app.model.construction_jobs()[0].uid)
		app.building_workflow.request_cancel_construction(uid);await frames();app.building_workflow.confirm_cancel(uid,false);await frames()
	check(app.model.state.wood==current.wood and app.model.state.stone==current.stone,"Construction refund unchanged")
	var player_before:Vector2=app.world.player.position
	app.show_character_guide("촌장집 2단계 · 마을 경계가 넓어졌어요","넓어진 마을에서 채집하고 새로운 건물을 지어 보세요.");await frames(1)
	var guide:CharacterGuide=app.overlay
	check(guide.panel_group.modulate.a>guide.character.modulate.a,"Panel precedes character")
	await create_timer(.7).timeout;await frames()
	check(is_equal_approx(guide.panel_group.get_node("CreamPanel").self_modulate.a,.8),"Panel opacity 80 percent")
	check(guide.heading.begins_with("촌장집"),"Guide content comes from caller")
	await shot("guide")
	var panel_at:Vector2=guide.layout.get_global_transform()*Vector2(900,580)
	click(panel_at);await frames();check(app.modal,"Inside guide tap stays open")
	click(Vector2(900,150));await frames()
	check(not app.modal and app.world.player.position.distance_to(player_before)<1 and app.navigation.path.is_empty(),"Outside dismiss consumes click without movement")
	app.show_character_guide("다른 제목","다른 안내");await create_timer(.6).timeout;await frames()
	guide=app.overlay;click(guide.close_button.get_global_rect().get_center());await frames()
	check(not app.modal,"Small X closes guide")
	app.show_character_guide("터치 닫기","모바일 닫기 버튼");await create_timer(.6).timeout;await frames()
	guide=app.overlay
	var close_at:Vector2=guide.close_button.get_global_rect().get_center()
	touch(close_at,0,true);touch(close_at,0,false);await frames()
	check(not app.modal,"Touch on small X closes guide without mouse emulation")
	var route_target:Vector2=app.world.player.position+Vector2(15,0)
	app.navigation.path=PackedVector2Array([route_target]);app.navigation.action="move";app.world.player.work_destination=route_target
	app.task="family";app.task_remaining=1.5;app.task_total=1.5
	app.show_character_guide("중단·복귀","안내가 열린 동안 작업을 유지합니다.");await frames()
	app._notification(Node.NOTIFICATION_APPLICATION_PAUSED);await frames()
	check(app.modal and app.navigation.action=="move" and app.task=="family","Pause keeps guide, route and work")
	app._notification(Node.NOTIFICATION_APPLICATION_RESUMED);await frames()
	check(app.world.player.presentation_paused and app.task_remaining==1.5,"Resume waits for guide dismissal before work")
	app.close_modal();await frames()
	check(app.task_remaining<1.5,"Work resumes after guide closes")
	app.cancel_task();await frames()
	app.show_character_guide("긴 안내 확인","긴 안내도 필요한 내용을 유지합니다. ".repeat(20));await create_timer(.6).timeout;await frames()
	guide=app.overlay
	check(guide.panel_group.get_node("GuideText") is ScrollContainer,"Long dynamic guidance scrolls")
	root.size=Vector2i(720,900);await frames(12)
	check(app.overlay is CharacterGuide,"Resize retains open guide and content");await create_timer(.6).timeout;await frames()
	guide=app.overlay
	var close_rect:Rect2=guide.close_button.get_global_rect()
	check(Rect2(Vector2.ZERO,Vector2(app.w,app.h)).encloses(close_rect),"Guide close remains in resized viewport")
	touch(Vector2(360,100),0,true);touch(Vector2(360,100),0,false);await frames()
	check(not app.modal,"Touch outside closes without world action")
	var reloaded:=GameState.new(SaveStore.new(app.model.store.directory))
	check(reloaded.state.wood==app.model.state.wood and reloaded.chief_level()==app.model.chief_level(),"Saved state survives reload")
	print(JSON.stringify({"checks":checks,"failures":failures,"rendered":true,"touch":"synthetic"}))
	app.queue_free();await frames();quit(0 if failures.is_empty() else 1)
