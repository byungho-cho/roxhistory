extends "res://tests/building_hold_v056_tests.gd"
func click(at:Vector2)->void:mouse(at,MOUSE_BUTTON_LEFT,true);mouse(at,MOUSE_BUTTON_LEFT,false)
func snap(file:String)->void:
	await frames(5);await RenderingServer.frame_post_draw
	root.get_texture().get_image().save_png("res://reports/v0160-"+file+".png")
func run()->void:
	root.size=Vector2i(1280,800)
	app=load("res://scenes/main.tscn").instantiate();root.add_child(app);await frames()
	app.model=GameState.new(SaveStore.new("user://camera0160_%d"%Time.get_ticks_usec()));app.model.start_new();app.model.changed.connect(app.update_hud)
	var state:Dictionary=app.model.state.duplicate(true);state.chief_level=1;state.resident_guide_seen=true;state.family_next_at=Time.get_unix_time_from_system()+10000;app.model.commit(state);app.model.set_debug_fast_build(false)
	app.enter_game();await frames(10)
	app.world.player.zoom_at(Vector2(app.w*.5,app.h*.5),1.0,app.model.building_position("chief"));await frames()
	app.building_workflow.request_upgrade();await frames()
	var hud:UpgradeConfirmation=app.overlay.get_node("UpgradeConfirmation")
	var center:=Vector2(app.w*.6,app.h*.64);var hero:Vector2=app.world.player.position;var wood:int=app.model.state.wood
	var camera:Vector2=app.world.player.camera_center
	mouse(center,MOUSE_BUTTON_LEFT,true);motion(center+Vector2(70,30));mouse(center+Vector2(70,30),MOUSE_BUTTON_LEFT,false);await frames()
	check(app.modal and app.overlay.name=="CompactUpgradeOverlay" and app.world.player.camera_center.distance_to(camera)>1,"Upgrade HUD permits mouse camera dragging")
	camera=app.world.player.camera_center
	mouse(center,MOUSE_BUTTON_MIDDLE,true);motion(center+Vector2(-45,10));mouse(center+Vector2(-45,10),MOUSE_BUTTON_MIDDLE,false);await frames()
	check(app.world.player.camera_center.distance_to(camera)>1 and app.modal,"Upgrade HUD permits middle mouse drag")
	camera=app.world.player.camera_center
	touch(center,0,true);drag_touch(center+Vector2(50,-15),0);touch(center+Vector2(50,-15),0,false);await frames()
	check(app.world.player.camera_center.distance_to(camera)>1 and app.modal,"Upgrade HUD permits single-finger camera drag")
	var zoom:float=app.world.player.zoom_factor
	mouse(center,MOUSE_BUTTON_WHEEL_UP,true);await frames()
	check(app.world.player.zoom_factor>zoom and app.modal,"Upgrade HUD permits ordinary wheel zoom")
	zoom=app.world.player.zoom_factor
	touch(center-Vector2(40,0),0,true);touch(center+Vector2(40,0),1,true);drag_touch(center+Vector2(65,0),1);await frames()
	check(app.gestures.pinching and app.world.player.zoom_factor>zoom,"Upgrade HUD permits two-finger pinch")
	touch(center-Vector2(40,0),0,false);touch(center+Vector2(65,0),1,false);await frames()
	check(app.modal and not app.gestures.blocked and app.model.state.wood==wood and app.world.player.position.distance_to(hero)<1,"Camera gesture never confirms, cancels or moves hero")
	check(is_equal_approx(hud.cost_display.scale.x,HudButtons.world_scale(app.world.get_global_transform_with_canvas().get_scale().x)),"Cost HUD and progress bar share zoom scaling")
	check(hud.cost_display.confirm_button.get_global_rect().size.is_equal_approx(Vector2(44,44)) and hud.cost_display.cancel_button.get_global_rect().size.is_equal_approx(Vector2(44,44)),"Confirm and cancel use matching screen-sized44px targets")
	var icon:TextureRect=hud.cost_display.cancel_button.art_feedback.get_node("Icon")
	check(icon.texture is AtlasTexture and icon.texture.atlas.resource_path.ends_with("build-cancel.png"),"HUD X uses approved icon asset")
	await snap("upgrade-camera")
	click(center);await frames();check(app.modal,"Background click does not discard upgrade selection")
	click(hud.cost_display.cancel_button.get_global_rect().get_center());await frames();check(not app.modal and not app.model.state.has("chief_upgrade") and app.model.state.wood==wood,"Upgrade cancel icon preserves resources")
	app.build_side.select_kind("hut");var at:=free_position("hut");app.build_preview.select_position(at,"hut");await frames()
	var before:Dictionary=app.model.state.duplicate(true)
	click(app.build_preview.cost_display.cancel_button.get_global_rect().get_center());await frames()
	check(not app.build_preview.active() and app.model.state==before,"Construction has explicit non-spending cancel")
	app.start_building_move("chief");await frames()
	check(app.build_preview.controls.get_child(0).get_global_rect().size.is_equal_approx(Vector2(44,44)),"Move cancel matches progress target")
	click(app.build_preview.controls.get_child(0).get_global_rect().get_center());await frames()
	check(not app.build_preview.active() and app.model.state==before,"Move cancel preserves saved position")
	at=free_position("hut");app.model.begin_construction("hut",at);await frames()
	var uid:=str(app.model.construction_jobs()[0].uid);var progress:ConstructionProgress=app.building_workflow.construction_progress[uid]
	for factor in [.65,1.5]:
		app.world.player.zoom_at(center,factor,at);await frames()
		check(progress.cancel_button.get_global_rect().size.is_equal_approx(Vector2(44,44)),"Progress cancel stays44px at zoom%f"%factor)
		check(is_equal_approx(progress.scale.x,HudButtons.world_scale(app.world.get_global_transform_with_canvas().get_scale().x)),"Progress follows shared HUD zoom rule")
	await snap("progress-zoom")
	app.building_workflow.request_cancel_construction(uid);await frames()
	var actions:Control=app.overlay.find_child("ModalActions",true,false)
	check(actions.get_child_count()==1 and actions.get_child(0).text=="공사 취소","Ordinary confirmation has one bottom action")
	check(app.overlay.find_child("ModalClose",true,false)!=null,"Ordinary confirmation has icon close at top")
	await snap("cancel-popup")
	var outside:=Vector2(12,app.h-15);touch(outside,0,true);touch(outside,0,false);await frames()
	check(not app.modal and app.model.construction_jobs().size()==1 and app.navigation.path.is_empty(),"Popup outside touch cancels dialog without refund or world action")
	app.building_workflow.request_cancel_construction(uid);await frames()
	click(app.overlay.find_child("ModalClose",true,false).get_global_rect().get_center());await frames()
	check(not app.modal and app.model.construction_jobs().size()==1,"Popup X keeps construction running")
	app.building_workflow.request_cancel_construction(uid);await frames();actions=app.overlay.find_child("ModalActions",true,false)
	click(actions.get_child(0).get_global_rect().get_center());await frames()
	check(app.model.construction_jobs().is_empty() and app.model.state.wood==wood,"Bottom action cancels construction and refunds once")
	app.model.set_debug_fast_build(true);at=free_position("hut");app.model.begin_construction("hut",at);await frames()
	uid=str(app.model.construction_jobs()[0].uid);progress=app.building_workflow.construction_progress[uid]
	check(app.model.construction_jobs()[0].clock_duration==5 and int(progress.timer.text.get_slice(":",2)) in [1,2,3,4,5],"Live development progress displays at most5 seconds")
	await snap("fast-five")
	app.building_workflow.request_cancel_construction(uid);await frames();app.building_workflow.confirm_cancel(uid,false);await frames()
	app.quest_details();await frames()
	var quest:Control=app.overlay.get_node("QuestScreen");var content:Control=quest.get_node("QuestPanel/QuestContent")
	check(quest.size==Vector2(1280,720) and not app.stage.visible,"Quest uses design canvas with underlying HUD hidden")
	check(content.get_node("WoodProgress").position==Vector2(565,463),"Quest progress placement matches design")
	check(content.get_node("WoodProgress").size==Vector2(242,12),"Quest progress height matches design12px")
	check(content.find_child("TrackQuest",true,false).position==Vector2(957,532),"Quest tracking footer matches design")
	await snap("quest-aligned")
	var track_at:Vector2=content.get_node("TrackQuest").get_global_rect().get_center()
	touch(track_at,0,true);touch(track_at,0,false);await frames()
	check(not app.modal and app.stage.visible,"Touch tracking action closes quest and restores HUD")
	app.quest_details();await frames();quest=app.overlay.get_node("QuestScreen")
	click(quest.get_node("QuestClose").get_global_rect().get_center());await frames();check(not app.modal and app.stage.visible,"Quest close restores gameplay HUD")
	app.quest_details();await frames();app.show_modal("확인","안내 전환",[{"text":"확인","action":app.close_modal}],false,true);await frames()
	check(app.stage.visible,"Replacing quest with another popup restores gameplay HUD visibility")
	app.close_modal()
	app.show_character_guide("아이콘 확인","공통 닫기 에셋");await create_timer(.6).timeout;await frames()
	var guide:CharacterGuide=app.overlay
	check(guide.close_button.art_feedback.get_node("Icon").texture.atlas.resource_path.ends_with("build-cancel.png"),"Character guide uses approved X icon")
	await snap("guide-icon");app.close_modal()
	state=app.model.state.duplicate(true);state.pending_family_count=1;app.model.commit(state);await frames()
	var bubble:Control=app.family.bubble
	check(is_equal_approx(app.family.headline.position.y,10) and app.family.headline.position.x==50,"Resident text aligns with centered portrait")
	check(absf(bubble.size.x-(app.family.headline.get_theme_font("font").get_string_size(app.family.headline.text,HORIZONTAL_ALIGNMENT_LEFT,-1,14).x+60))<1,"Bubble width fits actual one-line message")
	await snap("quest-padding-bubble")
	print(JSON.stringify({"checks":checks,"failures":failures,"touch":"synthetic Windows touch, not Android hardware"}))
	app.queue_free();await frames();quit(0 if failures.is_empty() else 1)
