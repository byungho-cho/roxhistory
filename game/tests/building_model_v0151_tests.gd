extends SceneTree
var checks:=0
var failures:Array[String]=[]
func check(ok:bool,label:String)->void:
	checks+=1
	if not ok:failures.append(label);push_error(label)
func _initialize()->void:call_deferred("run")
func run()->void:
	var folder:="user://building_model_v0151_%s"%Time.get_ticks_usec()
	var store:=SaveStore.new(folder)
	var model:=GameState.new(store)
	var now:=floorf(Time.get_unix_time_from_system())+10000.0
	check(model.start_new(),"Fresh save validates")
	check(model.chief_level()==0 and model.completed_hut_count()==0,"New game has no HQ")
	check(model.state.wood==99999 and model.state.stone==99999 and model.state.tokens==99999,"All test balances99999")
	check(not model.can_build() and not model.can_upgrade_chief(),"HQ0 locks resident build and upgrade")
	check(model.can_construct("chief") and model.building_unlocked("chief"),"HQ0 permits first HQ")
	check(model.debug_unlimited_builders and model.debug_fast_build and model.debug_unlimited_buildings and model.debug_show_boundary,"All development switches default ON for a fresh game")
	model.set_debug_fast_build(false);model.debug_unlimited_buildings=false;model.debug_show_boundary=false
	model.debug_unlimited_builders=false
	check(not model.debug_unlimited_builders and model.state.debug_unlimited_builders==false,"Direct builder toggle saves and reads back")
	model=GameState.new(store)
	check(not model.debug_unlimited_builders,"Single-builder choice survives reload")
	model.debug_unlimited_builders=true
	model=GameState.new(store)
	check(model.debug_unlimited_builders,"Direct unlimited reenable survives reload")
	model.busy=true
	check(not model.set_debug_unlimited_builders(false) and model.debug_unlimited_builders,"Busy builder setter cannot mutate settings")
	model.busy=false
	var expected:={"chief":[[20,20],[50,50],[100,100],[300,300]],"hut":[[20,10],[30,20],[50,30],[100,50]],"shrine":[[10,20],[20,30],[30,50],[50,100]],"hearth":[[10,10],[30,30],[50,50],[100,100]],"outpost":[[10,10],[30,30],[50,50],[100,100]],"training":[[10,10],[20,20],[30,30],[50,50]]}
	for kind in expected:
		for target in range(1,5):
			var cost:=model.building_cost(kind,target)
			check(cost=={"wood":expected[kind][target-1][0],"stone":expected[kind][target-1][1]},"Exact cost %sL%d"%[kind,target])
	for target in range(1,5):check(model.chief_upgrade_duration(target)==[60.0,600.0,1800.0,10800.0][target-1],"Exact L%d duration"%target)
	check(model.begin_construction("chief",DemoConfig.CHIEF_POSITION,now),"Start durable HQ")
	check(model.chief_level()==0 and model.state.wood==99979 and model.state.stone==99979,"HQ deduction precedes completion")
	check(not model.begin_construction("chief",Vector2(200,500),now),"Duplicate HQ rejected")
	var uid:=str(model.construction_jobs()[0].uid)
	check(model.construction_jobs()[0].finishes_at==now+60,"New construction lasts60s")
	check(not model.finish_constructions(now+59),"No early completion")
	var reloaded:=GameState.new(store)
	check(reloaded.construction_jobs().size()==1 and reloaded.chief_level()==0,"Pending HQ survives reload")
	check(model.cancel_construction(uid),"Cancel pending HQ")
	check(model.state.wood==99999 and model.state.stone==99999 and model.chief_level()==0,"Exact cancel full refund")
	check(not model.cancel_construction(uid),"Cancel idempotent")
	check(model.begin_construction("chief",DemoConfig.CHIEF_POSITION,now),"Restart HQ")
	check(model.finish_constructions(now+60) and model.chief_level()==1,"HQ completes by clock")
	check(not model.finish_constructions(now+60),"Construction completion idempotent")
	check(model.can_construct("hut") and not model.can_construct("hearth") and not model.can_construct("training") and not model.can_construct("outpost"),"HQ1 unlocks only huts")
	check(model.begin_construction("hut",DemoConfig.BUILD_SITES[0],now),"Start hut")
	check(not model.begin_construction("hut",DemoConfig.BUILD_SITES[1],now),"Pending hut reserves HQ cap")
	model.debug_unlimited_builders=false
	check(not model.can_upgrade_chief() and model.active_builder_jobs()==1,"Normal single builder accounts pending jobs")
	check(model.finish_constructions(now+60) and model.built_count()==1,"Hut completion creates owned home")
	var home_key:=model.home_key(0)
	check(not OwnedBuildingUpgrades.start(model,home_key,now),"Owned level never exceeds HQ for new actions")
	check(model.upgrade_chief(now),"Start HQ2 upgrade")
	check(model.placement_requirement("chief",DemoConfig.CHIEF_POSITION,"chief")=="공사를 완료하거나 취소한 후 이동할 수 있어요","HQ upgrade movement explains finish or cancel first")
	var before_move:=model.state.duplicate(true)
	check(not model.move_building("chief",DemoConfig.CHIEF_POSITION) and model.state==before_move,"Active HQ upgrade cannot move or mutate save")
	check(model.state.chief_upgrade.finishes_at==now+600,"HQ2 ten minutes")
	check(not model.can_construct("hut"),"Upgrade consumes only builder")
	check(model.cancel_upgrade("chief"),"Cancel HQ upgrade")
	check(model.move_building("chief",DemoConfig.CHIEF_POSITION),"HQ movement restored after cancellation")
	check(not model.cancel_upgrade("chief"),"HQ refund once")
	check(model.upgrade_chief(now) and model.finish_chief_upgrade(now+600),"Finish HQ2")
	check(model.building_unlocked("hearth") and model.building_unlocked("training") and not model.building_unlocked("shrine"),"HQ2 facilities unlock")
	check(OwnedBuildingUpgrades.start(model,home_key,now),"Hut2 starts")
	check(model.lookup_building(home_key).data.upgrade.cost=={"wood":30,"stone":20},"Upgrade uses kind-specific price")
	var before_refund:int=model.state.wood
	check(model.cancel_upgrade(home_key) and model.state.wood==before_refund+30,"Owned refund exact")
	check(not model.cancel_upgrade(home_key),"Owned cancellation idempotent")
	check(OwnedBuildingUpgrades.start(model,home_key,now),"Restart hut upgrade")
	check(OwnedBuildingUpgrades.finish(model,now+600),"Finish hut2")
	check(model.resident_capacity()==2,"Hut2 capacity")
	model.debug_unlimited_builders=true
	var fixture:=model.state.duplicate(true);fixture.chief_level=3
	check(model.commit(fixture),"Fixture HQ3")
	check(model.outpost_unlocked() and model.building_unlocked("shrine"),"HQ3 shrine/outpost")
	var points:={"hearth":Vector2(400,600),"training":Vector2(1800,600),"shrine":Vector2(400,1000),"outpost":Vector2(1800,1000)}
	for kind in points:check(model.begin_construction(kind,points[kind],now),"Begin %s"%kind)
	check(model.active_builder_jobs()==4,"Unlimited counts every job")
	check(model.finish_constructions(now+60),"Batch facilities finish")
	check(model.facilities().size()==3 and model.outposts().size()==1 and model.built_count()==1,"Facility separation from homes")
	for key in OwnedBuildingUpgrades.keys(model):
		var found:=model.lookup_building(key)
		check(found.has("kind") and found.has("position") and found.has("data"),"Generic lookup %s"%key)
		check(model.building_position(key).is_finite(),"Owned position %s"%key)
	var shrine_key:="shrine:"+str(model.facilities()[2].uid)
	check(OwnedBuildingUpgrades.start(model,shrine_key,now),"Facility upgrade starts")
	check(model.lookup_building(shrine_key).data.upgrade.cost=={"wood":20,"stone":30},"Shrine-specific upgrade")
	check(model.set_debug_fast_build(true,now+100),"Enable tenfold speed while upgrading")
	check(is_equal_approx(BuildingRules.progress(model.lookup_building(shrine_key).data.upgrade,now+100),1.0/6.0),"Enabling tenfold speed preserves elapsed one-sixth progress")
	check(is_equal_approx(float(model.lookup_building(shrine_key).data.upgrade.finishes_at),now+150),"Remaining500 seconds becomes50 seconds")
	reloaded=GameState.new(store)
	check(reloaded.debug_fast_build and reloaded.lookup_building(shrine_key).data.upgrade.finishes_at==now+150,"Persisted tenfold clock resumes across reload")
	check(reloaded.set_debug_fast_build(false,now+130),"Disable tenfold speed after30 accelerated seconds")
	check(is_equal_approx(BuildingRules.progress(reloaded.lookup_building(shrine_key).data.upgrade,now+130),2.0/3.0),"Disabling tenfold speed preserves two-thirds progress")
	check(is_equal_approx(float(reloaded.lookup_building(shrine_key).data.upgrade.finishes_at),now+330),"Remaining20 accelerated seconds becomes200 normal seconds")
	check(not OwnedBuildingUpgrades.finish(reloaded,now+329.5) and OwnedBuildingUpgrades.finish(reloaded,now+330),"Rescaled completion clock")
	check(reloaded.lookup_building(shrine_key).data.level==2,"Facility level2 applied")
	check(reloaded.move_building(shrine_key,Vector2(500,1200)),"Move facility arbitrary valid position")
	check(reloaded.building_position(shrine_key)==Vector2(500,1200),"Move position applied")
	check(not reloaded.move_building(shrine_key,model.building_position("chief")),"Overlapping move rejected")
	check(reloaded.move_building("chief",Vector2(1100,300)),"Move HQ")
	check(reloaded.set_debug_show_boundary(true),"Persist boundary setting")
	model=GameState.new(store)
	check(model.building_position(shrine_key)==Vector2(500,1200) and model.building_position("chief")==Vector2(1100,300),"Positions stable across reload")
	check(model.debug_show_boundary and not model.debug_fast_build,"Settings restore")
	fixture=model.state.duplicate(true);fixture.wood=99999;fixture.stone=99999;model.commit(fixture)
	check(model.gather(model.nodes()[0].id,Vector2.ZERO,now),"Harvest above99999")
	check(model.state.wood>99999 or model.state.stone>99999,"Gather does not truncate")
	check(model.demolition_quote("chief").is_empty() and not model.demolish("chief"),"HQ protected from demolition")
	var outpost_key:="outpost:"+str(model.outposts()[0].uid)
	var quote:=model.demolition_quote(outpost_key)
	check(quote.kind=="outpost" and quote.wood==10 and quote.stone==10,"Generic outpost demolition quote")
	before_refund=int(model.state.wood)
	check(model.demolish(outpost_key) and model.outposts().is_empty() and model.state.wood==before_refund+10,"Outpost demolition returns actual price")
	check(not model.demolish(outpost_key),"Demolition does not duplicate refund")
	check(OwnedBuildingUpgrades.start(model,shrine_key,now),"Fixture active shrine upgrade")
	check(model.placement_requirement("shrine",model.building_position(shrine_key),shrine_key)=="공사를 완료하거나 취소한 후 이동할 수 있어요","Facility upgrade movement explains finish or cancel first")
	before_move=model.state.duplicate(true)
	check(not model.move_building(shrine_key,model.building_position(shrine_key)) and model.state==before_move,"Active facility upgrade cannot move or mutate save")
	check(model.demolition_quote(shrine_key).is_empty() and not model.demolish(shrine_key),"Active upgrade protected from demolition")
	check(model.cancel_upgrade(shrine_key),"Cancel shrine3")
	check(model.move_building(shrine_key,model.building_position(shrine_key)),"Facility movement restored after cancellation")
	check(model.demolish(shrine_key) and model.lookup_building(shrine_key).is_empty(),"Facility generic demolition")
	check(model.claim_reward(0),"Claim before housing demolition")
	fixture=model.state.duplicate(true);fixture.resident_count=1;model.commit(fixture)
	check(model.demolition_quote(home_key).is_empty() and not model.demolish(home_key),"Occupied residents cannot lose required housing")
	fixture=model.state.duplicate(true);fixture.resident_count=0;model.commit(fixture)
	check(not model.demolition_quote(home_key).is_empty(),"Empty housing demolition supported")
	# Both construction and upgrades rescale, but other game clocks do not.
	fixture=model.state.duplicate(true);fixture.family_next_at=now+60;fixture.chief_level=4;model.commit(fixture)
	check(model.begin_construction("hut",Vector2(1700,1200),now),"Speed test pending new home")
	var construction_id:=str(model.construction_jobs()[0].uid)
	check(model.set_debug_fast_build(true,now+20),"Speedup pending construction")
	check(model.construction_jobs()[0].finishes_at==now+24 and model.state.family_next_at==now+60,"Construction accelerated; family clock unchanged")
	check(not model.finish_constructions(now+23) and model.finish_constructions(now+24),"Remaining40 normal seconds completes in4 accelerated seconds")
	check(not model.cancel_construction(construction_id),"Completed construction cannot refund")
	var before:int=model.state.wood
	check(model.set_debug_fast_build(false,now+25),"Restore ordinary clocks")
	# Every owned kind can finish level4, and no fifth upgrade exists.
	for key in OwnedBuildingUpgrades.keys(model):
		while int(model.lookup_building(key).data.get("level",1))<4:
			var level:int=model.lookup_building(key).data.get("level",1)
			var kind:String=model.lookup_building(key).kind
			var paid:=model.building_cost(kind,level+1)
			before=int(model.state.wood)
			check(OwnedBuildingUpgrades.start(model,key,now),"Start %sL%d"%[kind,level+1])
			check(model.state.wood==before-int(paid.wood),"Pay exact %sL%d price"%[kind,level+1])
			check(OwnedBuildingUpgrades.finish(model,now+BuildingRules.duration(level+1)),"Finish %sL%d"%[kind,level+1])
		check(not OwnedBuildingUpgrades.start(model,key,now),"No owned level5")
	# Old saves still load with implicit HQ1 and grandfathered owned levels/jobs.
	var legacy:=DemoConfig.fresh();legacy.erase("hq_can_be_absent");legacy.erase("chief_level");legacy.erase("debug_unlimited_builders")
	legacy.homes=[{"uid":"legacy-home","style":0,"claimed":true,"site":0,"level":3,"upgrade":{"from":3,"to":4,"started_at":now,"finishes_at":now+16,"cost":{"wood":20,"stone":20}}}]
	legacy.built=true;legacy.reward_claimed=true
	check(store.valid(legacy) and model.commit(legacy),"Legacy above-HQ upgrade save remains valid")
	model=GameState.new(store)
	check(model.chief_level()==1 and model.home_key(0)=="legacy-home","Legacy HQ and UID retained")
	check(model.debug_unlimited_builders,"Legacy save without builder preference keeps unlimited default")
	check(OwnedBuildingUpgrades.finish(model,now+16) and model.homes()[0].level==4,"Legacy in-flight clock retained")
	check(model.start_new(),"Reset offline fixture")
	check(model.begin_construction("chief",DemoConfig.CHIEF_POSITION,Time.get_unix_time_from_system()-61),"Past construction fixture")
	model=GameState.new(store)
	check(model.chief_level()==1 and model.construction_jobs().is_empty(),"Offline new construction finishes on load")
	check(model.upgrade_chief(Time.get_unix_time_from_system()-601),"Past HQ upgrade fixture")
	model=GameState.new(store)
	check(model.chief_level()==2 and not model.state.has("chief_upgrade"),"Offline HQ upgrade finishes on load")
	check(model.begin_construction("hut",DemoConfig.BUILD_SITES[0],now),"Cancellation race fixture")
	uid=str(model.construction_jobs()[0].uid)
	var reentry_result:Array[bool]=[]
	var reentry_callback:=func():reentry_result.append(model.cancel_construction(uid))
	model.changed.connect(reentry_callback,CONNECT_ONE_SHOT)
	check(model.cancel_construction(uid) and reentry_result==[false],"Reentrant changed listener cannot refund twice")
	var invalid:=model.state.duplicate(true);invalid.wood=INF;check(not store.valid(invalid),"Nonfinite inventory rejected")
	invalid=model.state.duplicate(true);invalid.chief_level=0;invalid.erase("hq_can_be_absent");check(not store.valid(invalid),"HQ0 requires explicit new-game flag")
	invalid=model.state.duplicate(true);invalid.debug_unlimited_builders=1;check(not store.valid(invalid),"Builder preference requires a boolean")
	invalid=model.state.duplicate(true);invalid.resident_count=16;check(not store.valid(invalid),"Population above15 rejected")
	invalid=model.state.duplicate(true);invalid.pending_family_count=4;check(not store.valid(invalid),"Party above3 rejected")
	invalid=model.state.duplicate(true);invalid.family_next_at=NAN;check(not store.valid(invalid),"Nonfinite family timer rejected")
	# Failed writes never charge/refund/apply settings or remove jobs in memory.
	model.set_debug_fast_build(false)
	check(model.begin_construction("hut",DemoConfig.BUILD_SITES[0],now),"Prepare save-failure job")
	uid=str(model.construction_jobs()[0].uid)
	var original:=model.state.duplicate(true)
	store.directory=folder.path_join("missing/not_created")
	check(not model.cancel_construction(uid) and model.state==original,"Failed save leaves cancellation unchanged")
	check(not model.set_debug_fast_build(true,now+1) and model.state==original,"Failed speed save preserves clocks")
	check(not model.set_debug_unlimited_builders(false) and model.state==original and model.debug_unlimited_builders,"Failed builder settings save preserves current choice")
	check(not model.finish_constructions(now+60) and model.state==original,"Failed completion preserves job and resources")
	store.directory=folder
	check(model.cancel_construction(uid),"Recover write and cancel once")
	for name in DirAccess.get_files_at(folder):DirAccess.remove_absolute(folder.path_join(name))
	DirAccess.remove_absolute(folder)
	print(JSON.stringify({"checks":checks,"failures":failures}))
	quit(0 if failures.is_empty() else 1)
