extends "res://tests/building_hold_v056_tests.gd"

func tap(at:Vector2)->void:
	touch(at,0,true)
	touch(at,0,false)

func run()->void:
	var folder:="user://first_quests_%d"%Time.get_ticks_usec()
	var model:=GameState.new(SaveStore.new(folder))
	check(model.start_new(),"Fresh game saved")
	check(model.state.wood==0 and model.state.stone==0 and model.state.grain==0,"Fresh stock is zero")
	check(not model.ensure_family_visit(),"First visit waits for a hut")
	var wood:String=""
	var stone:String=""
	for node in model.nodes():
		if node.kind=="wood" and wood.is_empty():wood=node.id
		if node.kind=="stone" and stone.is_empty():stone=node.id
	check(not wood.is_empty() and not stone.is_empty(),"Gather sources available from actual map fixture")
	check(model.gather(stone) and model.state.stone==10 and FirstQuests.current(model.state)==0,"Early stone gathering records success without advancing past wood")
	check(model.gather(wood) and model.state.wood==10 and FirstQuests.current(model.state)==0,"Wood gathering pays only the gathered amount")
	model=GameState.new(SaveStore.new(folder))
	check(model.state.stone==10 and model.state.wood==10 and not model.claim_quest_reward(1),"Reload preserves both pending rewards in order")
	check(model.claim_quest_reward(0) and model.state.wood==110 and not model.claim_quest_reward(0),"Wood reward pays once")
	check(FirstQuests.intro_reward_ready(model.state,1) and model.claim_quest_reward(1) and model.state.stone==110 and not model.gather(wood),"Early stone completion can be claimed next and normal cap applies")
	var now:=Time.get_unix_time_from_system()
	check(model.begin_construction("chief",DemoConfig.CHIEF_POSITION,now) and model.finish_constructions(now+60),"Chief construction completes")
	check(model.state.grain==0 and model.state.wood==90 and model.state.stone==90 and FirstQuests.intro_reward_ready(model.state,2),"Chief completion queues grain only")
	check(model.claim_quest_reward(2) and model.state.grain==100 and not model.claim_quest_reward(2),"Chief completion reward pays once")
	check(model.begin_construction("hut",Vector2(900,900),now) and model.finish_constructions(now+60),"First hut completes")
	check(FirstQuests.pending(model.state)==[3] and FirstQuests.current(model.state)==4,"An unclaimed hut reward does not gate the next quest")
	check(model.ensure_family_visit() and model.family_visitor_count()==1,"First visit has exactly one resident after hut completion")
	check(ResidentAdmission.join(model,now) and FirstQuests.current(model.state)==5,"Admission advances the quest")
	check(model.ensure_family_visit(now+61) and model.family_visitor_count() in [1,2],"Later visits contain one or two residents")
	model.store.blocked=true
	check(not model.claim_quest_reward(3) and model.state.grain==100,"Failed save does not award or claim")
	model.store.blocked=false
	check(model.claim_quest_reward(3) and model.state.grain==150 and not model.claim_quest_reward(3),"Repeated reward claim pays exactly once")
	model=GameState.new(SaveStore.new(folder))
	check(model.state.grain==150 and not model.claim_quest_reward(3),"Manual receipt persists across reload")
	var legacy_store:=SaveStore.new(folder+"_legacy")
	var legacy:=DemoConfig.fresh()
	legacy.chief_level=2
	legacy.wood=275
	check(legacy_store.save_game(legacy,true),"Legacy fixture saved")
	var migrated:=GameState.new(legacy_store)
	check(migrated.state.wood==375 and migrated.state.grain==100 and "chief_upgrade" in migrated.state.quests_done,"Legacy milestones credited without truncating existing stock")
	check(GameState.new(legacy_store).state.wood==375,"Legacy credit is idempotent")
	root.size=Vector2i(1280,800)
	app=load("res://scenes/main.tscn").instantiate()
	root.add_child(app)
	await frames()
	app.model=model
	model.changed.connect(app.update_hud)
	var state:=model.state.duplicate(true)
	state.resident_guide_seen=true
	state.pending_family_count=0
	state.family_next_at=now+10000
	model.commit(state)
	app.enter_game()
	await frames(12)
	var journal:Control=app.stage.get_node("JournalButton")
	var main_inventory:Control=app.action_row.get_child(3)
	check(journal.global_position.x<app.stage.get_node("QuestRewardEntry").global_position.x,"Journal appears to the left of rewards")
	var journal_icon:TextureRect=journal.get_node("EntryIcon")
	var reward_icon:TextureRect=app.stage.get_node("QuestRewardEntry/EntryIcon")
	check(is_equal_approx(journal_icon.global_position.y+journal_icon.get_meta("visible_baseline"),reward_icon.global_position.y+reward_icon.get_meta("visible_baseline")),"Journal and reward artwork share a visible baseline")
	app.construction_menu()
	check(app.build_side.transition!=null and app.build_side.modulate.a<1.0,"Building list starts an opening animation")
	await app.build_side.transition.finished
	check(app.build_side.visible and not main_inventory.visible and not app.menu_toggle.visible,"Building list replaces main actions")
	check(app.build_side.visible_slots==5 and app.build_side.left_hint.visible and not app.build_side.right_hint.visible,"Right edge displays five entries and only the left arrow")
	var fixed_at:Vector2=app.build_button.global_position
	tap(app.build_side.left_hint.get_global_rect().get_center())
	await frames()
	check(app.build_side.right_hint.visible and app.build_button.global_position==fixed_at and not app.world.simulation_paused,"Arrow scroll leaves construction button fixed and simulation running")
	if DisplayServer.get_name()!="headless":
		await RenderingServer.frame_post_draw
		root.get_texture().get_image().save_png("res://reports/tutorial-build-menu.png")
	tap(app.build_button.get_global_rect().get_center())
	check(app.build_side.transition!=null and app.build_button.global_position==fixed_at,"Closing animation starts with the build button fixed")
	await app.build_side.transition.finished
	await frames()
	check(not app.build_side.visible and app.menu_toggle.visible,"Construction toggles back to main actions")
	var entry:Button=app.stage.get_node("QuestRewardEntry")
	tap(entry.get_global_rect().get_center())
	await frames()
	check(app.modal and app.overlay.has_node("QuestRewardPanel"),"Lower left reward entry opens the popup")
	var panel:Control=app.overlay.get_node("QuestRewardPanel")
	tap(panel.get_global_rect().position+Vector2(45,80))
	await frames()
	check(app.modal and model.state.grain==150,"Panel body consumes input without awarding")
	if DisplayServer.get_name()!="headless":
		await RenderingServer.frame_post_draw
		root.get_texture().get_image().save_png("res://reports/first-quest-rewards.png")
	var button:Button=panel.find_child("ClaimQuest4",true,false)
	tap(button.get_global_rect().get_center())
	await frames()
	check(app.modal and model.state.grain==200 and FirstQuests.pending(model.state).is_empty(),"Reward button pays individual card and refreshes popup")
	var close:Button=panel.get_node("QuestRewardClose")
	check(close.get_global_rect().size.x>=47.9,"Close touch area is at least 48 logical pixels")
	tap(close.get_global_rect().get_center())
	await frames()
	check(not app.modal and model.state.grain==200,"X closes without another award")
	tap(entry.get_global_rect().get_center())
	await frames()
	tap(Vector2(10,10))
	await frames()
	check(not app.modal and model.state.grain==200,"Backdrop closes without awarding")
	var chief:Sprite2D=app.world.building_sprite("chief")
	check(chief.texture.resource_path.ends_with("chief-retouch/l1.png"),"Actual chief uses approved art")
	if DisplayServer.get_name()!="headless":
		app.world.player.zoom_at(Vector2(app.w,app.h)*.5,1.1,model.building_position("chief"))
		await frames(8)
		await RenderingServer.frame_post_draw
		root.get_texture().get_image().save_png("res://reports/first-quest-chief.png")
	check(model.upgrade_chief(now) and model.finish_chief_upgrade(now+61),"Chief upgrade completes")
	check(FirstQuests.current(model.state)==6,"Upgrade advances to farm")
	check(model.begin_construction("farm",Vector2(1300,1000),now) and model.finish_constructions(now+61),"Farm construction completes")
	var farm:Dictionary=model.facilities()[0]
	check(ResidentJobs.new(model).assign("resident-0","farmer","farm:"+str(farm.uid)),"Farmer can be assigned normally")
	check(FirstQuests.current(model.state)==-1 and FirstQuests.pending(model.state)==[5,6,7],"All eight quests complete without requiring reward collection")
	app.close_modal()
	app.building_workflow.pending_growth_notice=""
	tap(entry.get_global_rect().get_center())
	await frames()
	var bulk:Button=app.overlay.find_child("ClaimAllQuestRewards",true,false)
	tap(bulk.get_global_rect().get_center())
	check(model.state.grain==350 and not model.claim_all_quest_rewards(),"Bulk rewards commit once")
	check(GameState.new(SaveStore.new(folder)).state.grain==350,"Bulk reward receipts persist across reload")
	for level in range(1,5):
		var stage_state:=model.state.duplicate(true)
		stage_state.chief_level=level
		model.commit(stage_state)
		check(app.world.building_sprite("chief").texture.resource_path.ends_with("chief-retouch/l%d.png"%level),"Chief %d uses its approved retouch"%level)
	app.close_modal()
	app.building_workflow.pending_growth_notice=""
	check(model.start_new(),"Isolated fixture resets for guide checks")
	await frames(4)
	check(app.overlay is CharacterGuide and app.overlay.heading==FirstQuests.INTRO_GUIDES[0],"First wood quest presents its guide")
	app.close_modal()
	await frames(2)
	check(app.build_button.disabled and app.build_lock_icon.visible,"Construction starts locked")
	check(app.gather_button.disabled and not app.stage.get_node("QuestRewardEntry").visible,"Ordinary gathering is locked and rewards start hidden")
	app.construction_menu()
	check(not app.choosing_plot and not app.modal,"Locked construction cannot open placement")
	var designated: String=app.tutorial.target_id
	check(not designated.is_empty(),"Tutorial selects a reachable wood target")
	if DisplayServer.get_name()!="headless":
		await RenderingServer.frame_post_draw
		root.get_texture().get_image().save_png("res://reports/tutorial-wood-target.png")
	var designated_at: Vector2=app.world.art_nodes[designated].position
	app.world.player.position=app.world.gather_stand(designated_at,"wood")
	app.world.player.camera.reset_smoothing()
	await frames(2)
	var target_sprite: Sprite2D=app.world.art_nodes[designated].get_child(0)
	tap(Vector2(30,30))
	check(app.task.is_empty(),"Unrelated tutorial tap does not start a task")
	tap(target_sprite.get_global_transform_with_canvas()*BuildingVisuals.visible_rect(target_sprite).get_center())
	check(app.task=="gather" and app.task_target==designated,"Designated wood tap starts gathering despite locked button")
	app.finish_task()
	await frames(4)
	check(app.overlay is CharacterGuide and app.overlay.heading==FirstQuests.INTRO_SUCCESSES[0] and model.state.wood==10,"Wood success waits for a tap")
	tap(Vector2(30,30))
	await frames(4)
	check(app.overlay is CharacterGuide and app.overlay.heading==FirstQuests.INTRO_GUIDES[1] and model.state.wood==110,"Tapping claims wood and shows the stone guide")
	app.close_modal()
	check(model.gather(stone),"Guide fixture gathers stone")
	await frames(4)
	check(app.overlay is CharacterGuide and app.overlay.heading==FirstQuests.INTRO_SUCCESSES[1] and app.build_lock_icon.visible,"Stone success keeps construction locked until claimed")
	tap(Vector2(30,30))
	await frames(4)
	check(app.overlay is CharacterGuide and app.overlay.heading==FirstQuests.INTRO_GUIDES[2] and not app.build_lock_icon.visible,"Claiming stone unlocks construction and shows the chief guide")
	app.close_modal()
	tap(app.build_button.get_global_rect().get_center())
	check(app.choosing_plot and app.build_kind=="chief" and not app.build_preview.active(),"Unlocked construction highlights a plot before placement")
	var plot:Vector2=app.tutorial.plot
	check(plot.is_finite() and app.world.placement_requirement("chief",plot).is_empty(),"The tutorial plot is clear of obstacles")
	tap(app.world.get_global_transform_with_canvas()*plot)
	check(app.build_preview.active() and app.build_preview.placement_position==plot,"Designated plot tap opens confirmation")
	await frames()
	tap(app.build_preview.cost_display.confirm_button.get_global_rect().get_center())
	check(model.pending_construction_count("chief")==1,"Tutorial confirmation starts chief construction")
	var scheduled:=VillageNotifications.schedule(model)
	check(scheduled.size()==1,"Construction completion has one scheduled notice")
	check(VillageNotifications.set_enabled(model,"construction",false) and VillageNotifications.schedule(model).is_empty(),"Disabling notifications removes the planned notice")
	check(VillageNotifications.set_enabled(model,"construction",true) and VillageNotifications.schedule(model).size()==1,"Re-enabling restores the same completion notice")
	var job:Dictionary=model.construction_jobs()[0]
	check(model.finish_constructions(float(job.finishes_at)) and VillageNotifications.schedule(model).is_empty(),"Completing construction clears its schedule")
	await frames(4)
	check(app.overlay is CharacterGuide and app.overlay.heading==FirstQuests.INTRO_SUCCESSES[2] and model.state.grain==0,"Chief success waits for a tap")
	tap(Vector2(30,30))
	await frames(4)
	check(app.overlay is CharacterGuide and app.overlay.heading==FirstQuests.TITLES[3] and model.state.grain==100,"Tapping claims grain and shows the first hut guide")
	app.close_modal()
	await frames(2)
	check(not app.tutorial.active() and not app.gather_button.disabled,"Chief reward unlocks ordinary gathering")
	check(model.begin_construction("hut",Vector2(900,900),now) and model.finish_constructions(now+61),"A hut provides room for the first visitor")
	check(model.ensure_family_visit(),"The first visitor arrives")
	var visited:=model.state.duplicate(true)
	visited.resident_guide_seen=true
	model.commit(visited)
	await frames()
	var visitor:Node2D=app.world.visitors[0]
	var visitor_tap:Vector2=app.world.get_global_transform_with_canvas()*app.world.visitor_bounds(visitor).get_center()
	app.world_tap(visitor_tap)
	check(model.resident_count()==1 and not model.family_available(),"Tapping the visitor body admits the party")
	app.close_modal()
	app.world_tap(visitor_tap)
	check(model.resident_count()==1,"Tapping the old visitor position cannot admit twice")
	print(JSON.stringify({"checks":checks,"failures":failures}))
	app.queue_free()
	await frames()
	quit(0 if failures.is_empty() else 1)
