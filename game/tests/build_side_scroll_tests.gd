extends "res://tests/building_hold_v056_tests.gd"
func run()->void:
	root.size=Vector2i(1280,800)
	app=load("res://scenes/main.tscn").instantiate();root.add_child(app);await frames()
	app.test_mode=true;app.model=GameState.new(SaveStore.new("user://menu_scroll_%d"%Time.get_ticks_usec()));app.model.start_new()
	var fixture:Dictionary=app.model.state.duplicate(true);fixture.chief_level=4;fixture.wood=50;fixture.stone=50;fixture.resident_guide_seen=true;fixture.family_next_at=Time.get_unix_time_from_system()+10000;app.model.commit(fixture)
	app.enter_game();await frames(8)
	var menu:BuildSideMenu=app.build_side
	menu.show();await frames()
	check(menu.visible_slots==6,"Wide screen shows at most six slots")
	check(menu.scale==Vector2.ONE and menu.hut.size==BuildSideMenu.TILE_SIZE,"Touch slots stay full-sized")
	check(BuildSideMenu.ART_SCALE>=.85,"Submenu artwork fills its readable touch slot")
	check(is_equal_approx(menu.scroll_offset,menu.max_scroll()),"Opens at rightmost hut")
	check(menu.left_hint.visible and not menu.right_hint.visible,"Overflow hints match direction")
	var at:=menu.hut.get_global_rect().get_center()
	mouse(at,MOUSE_BUTTON_LEFT,true);await frames()
	check(menu.hut.finger>=0 and menu.hut.art_feedback.scale.x<1,"Mouse press animates artwork")
	var camera_before:Vector2=app.world.player.camera.global_position
	motion(at+Vector2(120,0));await frames()
	check(menu.dragged and menu.scroll_offset<menu.max_scroll(),"Horizontal drag scrolls menu")
	check(menu.hut.finger<0,"Dragging cancels button press feedback")
	mouse(at+Vector2(120,0),MOUSE_BUTTON_LEFT,false);await frames()
	check(menu.visible and not app.choosing_plot,"Drag release cannot select a building")
	check(app.world.player.camera.global_position.distance_to(camera_before)<.1,"Menu drag does not pan world")
	check(menu.pointer==-2 and app.gestures.touches.is_empty(),"Pointer state released")
	menu.hide();menu.show();await frames()
	at=menu.hut.get_global_rect().get_center();touch(at,3,true);await frames()
	check(menu.hut.finger>=0,"Touch press animates artwork")
	drag_touch(at+Vector2(90,0),3);touch(at+Vector2(90,0),3,false);await frames()
	check(menu.visible and not app.choosing_plot and menu.pointer==-2,"Touch drag scrolls without selecting")
	var offset:=menu.scroll_offset
	mouse(menu.get_global_rect().get_center(),MOUSE_BUTTON_WHEEL_UP,true);await frames()
	check(menu.scroll_offset<offset,"Wheel scrolls towards left entries")
	menu.scroll_by(-10000);check(not menu.left_hint.visible and menu.right_hint.visible,"Left boundary clamps with right hint")
	mouse(menu.global_position+Vector2(menu.size.x-12,40),MOUSE_BUTTON_LEFT,true)
	mouse(menu.global_position+Vector2(menu.size.x-12,40),MOUSE_BUTTON_LEFT,false);await frames()
	check(menu.scroll_offset>0,"Right arrow advances visible page")
	menu.hide();menu.show();at=menu.hut.get_global_rect().get_center()
	mouse(at,MOUSE_BUTTON_LEFT,true);menu.hide();await frames()
	check(menu.pointer==-2 and menu.hut.finger<0,"Hiding cancels a held press")
	mouse(at,MOUSE_BUTTON_LEFT,false);menu.show();await frames()
	at=menu.hut.get_global_rect().get_center();touch(at,5,true);touch(at,5,false);await frames()
	check(app.choosing_plot and app.build_kind=="hut" and not menu.visible,"Tap still selects the hut")
	app.cancel_build_preview();menu.show();await frames()
	at=menu.entries.farm.get_global_rect().get_center()
	check(menu.entries.farm.disabled,"Farm stays locked without completed hut")
	touch(at,6,true);touch(at,6,false);await frames()
	check(menu.visible and not app.choosing_plot,"Locked tap cannot enter placement")
	at=menu.hut.get_global_rect().get_center();mouse(at,MOUSE_BUTTON_LEFT,true)
	mouse(menu.global_position-Vector2(30,30),MOUSE_BUTTON_LEFT,false);await frames()
	check(menu.pointer==-2 and not app.choosing_plot,"Release outside cancels tap")
	check(not menu.kind_at(menu.content.global_position+Vector2(20,40)),"Clipped out entries cannot be selected")
	var real_width:float=app.w;app.w=400;menu.refresh()
	check(menu.visible_slots<6 and menu.hut.size==BuildSideMenu.TILE_SIZE and menu.size.x<=400-app.safe.x*2,"Narrow viewport uses fewer slots, not tiny hit targets")
	app.w=real_width;menu.refresh();menu.hide()
	print(JSON.stringify({"checks":checks,"failures":failures,"scope":"headless synthetic mouse/touch, not hardware gameplay"}))
	app.queue_free();await frames();quit(0 if failures.is_empty() else 1)
