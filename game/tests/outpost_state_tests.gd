extends SceneTree
var checks:=0
var failures:Array[String]=[]
func check(ok:bool,label:String)->void:
	checks+=1
	if not ok:failures.append(label);push_error(label)
func _initialize()->void:call_deferred("run")
func run()->void:
	var folder:="user://tests/outpost_%s"%Time.get_ticks_usec()
	var store:=SaveStore.new(folder)
	var model:=GameState.new(store)
	check(not model.can_build_outpost(),"Empty state locked")
	check(model.start_new(),"Isolated test save created")
	check(model.completed_hut_count()==1 and model.chief_level()==1,"Chief included once; old save defaults to level one")
	var next:=model.state.duplicate(true);next.wood=200;next.stone=200
	check(model.commit(next),"Test inventory saved")
	check(not model.upgrade_chief(),"Upgrade locked without completed outpost")
	check(model.build(Vector2.ZERO,0) and model.build(Vector2.ZERO,1),"Two resident huts built")
	check(model.completed_hut_count()==3 and not model.outpost_unlocked(),"Three total huts still locked")
	var before:=model.state.duplicate(true)
	check(not model.build_outpost(Vector2.ZERO,3) and model.state==before,"Locked attempt leaves resources and save unchanged")
	check(model.build(Vector2.ZERO,2),"Third resident hut built")
	check(model.completed_hut_count()==4 and model.outpost_unlocked(),"Chief plus three huts unlocks")
	var loaded:=GameState.new(SaveStore.new(folder))
	check(loaded.outpost_unlocked(),"Unlock recomputed after reload")
	for balances in [[14,10],[15,9]]:
		next=model.state.duplicate(true);next.wood=balances[0];next.stone=balances[1];model.commit(next)
		before=model.state.duplicate(true)
		check(not model.can_build_outpost() and not model.build_outpost(Vector2.ZERO,3) and model.state==before,"Insufficient wood or stone cannot charge/build")
	next=model.state.duplicate(true);next.wood=15;next.stone=10;model.commit(next)
	before=model.state.duplicate(true)
	check(not model.build_outpost(Vector2.ZERO,0) and model.state==before,"Occupied hut plot rejected without charge")
	check(not model.build_outpost(Vector2.ZERO,-1) and not model.build_outpost(Vector2.ZERO,99),"Invalid plots rejected")
	store.directory=folder.path_join("missing/not_created")
	check(not model.build_outpost(Vector2.ZERO,3) and model.state==before,"Write failure rolls back payment and tower")
	store.directory=folder
	check(model.build_outpost(Vector2.ZERO,3),"Level-one outpost transaction succeeds")
	check(model.state.wood==0 and model.state.stone==0,"Exact 15 wood and 10 stone charged")
	check(model.outposts().size()==1 and model.outposts()[0].level==1 and model.built_count()==3,"Outpost separate from housing count")
	check(model.state.tokens==0 and not model.site_free(3),"No seed grant; outpost plot occupied")
	loaded=GameState.new(SaveStore.new(folder))
	check(loaded.outposts()==JSON.parse_string(JSON.stringify(model.outposts())),"Outpost identity/level/cost/site survive reload")
	check(not loaded.can_upgrade_chief(),"Upgrade also requires materials")
	next=model.state.duplicate(true);next.wood=100;next.stone=100;model.commit(next)
	before=model.state.duplicate(true)
	check(not model.build_outpost(Vector2.ZERO,3) and not model.build(Vector2.ZERO,3) and model.state==before,"Neither type can overlap completed outpost")
	check(model.claim_reward(0) and model.demolish(model.home_key(0)),"Existing demolition remains usable")
	check(model.completed_hut_count()==3 and not model.outpost_unlocked() and model.outposts().size()==1,"Demolition relocks NEW towers and preserves existing tower")
	loaded=GameState.new(SaveStore.new(folder))
	check(not loaded.outpost_unlocked() and loaded.outposts().size()==1,"Relock and preserved tower survive restart")
	check(model.can_upgrade_chief(),"Completed tower still unlocks chief upgrade after hut demolition")
	check(model.chief_upgrade_cost()=={"wood":20,"stone":20},"All upgrades use current initial hut cost 20/20")
	for level in [2,3,4]:
		before=model.state.duplicate(true)
		var start:=Time.get_unix_time_from_system()+1000
		var duration:=float({2:4,3:8,4:16}[level])
		check(model.upgrade_chief(start) and model.chief_level()==level-1,"Upgrade starts without premature completion %d"%level)
		check(model.state.wood==before.wood-20 and model.state.stone==before.stone-20,"Fixed 20/20 charged at level %d"%level)
		check(model.chief_upgrade_remaining(start)==duration,"Duration is %s seconds"%duration)
		var paid:=model.state.duplicate(true)
		check(not model.upgrade_chief(start) and model.state==paid,"Repeated start cannot double-charge")
		loaded=GameState.new(SaveStore.new(folder))
		check(loaded.chief_level()==level-1 and loaded.chief_upgrade_remaining(start+1)==duration-1,"Pending job and remaining time restored")
		check(not model.finish_chief_upgrade(start+duration-0.01),"Cannot finish before deadline")
		check(model.chief_upgrade_remaining(start-10)==duration+10,"Clock rollback waits rather than premature completion")
		store.directory=folder.path_join("missing/not_created")
		check(not model.finish_chief_upgrade(start+duration) and model.state==paid,"Failed completion write retains pending state for retry")
		store.directory=folder
		check(model.finish_chief_upgrade(start+duration) and model.chief_level()==level,"Finish advances exactly one level")
		check(not model.finish_chief_upgrade(start+duration+1) and model.state.wood==paid.wood and model.state.stone==paid.stone,"Repeated finish neither charges nor advances")
	before=model.state.duplicate(true)
	check(not model.upgrade_chief() and model.state==before,"Level four cap rejects repeat without charge")
	loaded=GameState.new(SaveStore.new(folder))
	check(loaded.chief_level()==4 and loaded.state==JSON.parse_string(JSON.stringify(model.state)),"Upgraded state restores exactly")
	var invalid:=model.state.duplicate(true);invalid.outposts[0].site=int(invalid.homes[0].site)
	check(not store.valid(invalid),"Cross-type duplicate site rejected by save validation")
	invalid=model.state.duplicate(true);invalid.outposts[0].level=2
	check(not store.valid(invalid),"Unimplemented outpost upgrade rejected")
	invalid=model.state.duplicate(true);invalid.chief_level=5
	check(not store.valid(invalid),"Invalid chief level rejected")
	next=model.state.duplicate(true);next.chief_level=3;next.wood=40;next.stone=40;model.commit(next)
	check(model.upgrade_chief(Time.get_unix_time_from_system()-100),"Offline completion test starts once")
	loaded=GameState.new(SaveStore.new(folder))
	check(loaded.chief_level()==4 and not loaded.state.has("chief_upgrade") and loaded.state.wood==20,"Elapsed offline job completes on load without charging again")
	var again:=GameState.new(SaveStore.new(folder))
	check(again.state==JSON.parse_string(JSON.stringify(loaded.state)),"Second reload remains idempotent")
	print(JSON.stringify({"checks":checks,"failures":failures}))
	quit(0 if failures.is_empty() else 1)
