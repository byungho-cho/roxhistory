extends "res://tests/windows_v052_tests.gd"
func touch(at:Vector2,id:int,down:bool)->void:
	var e:=InputEventScreenTouch.new();e.position=at;e.index=id;e.pressed=down;root.push_input(e,true)
func drag_touch(at:Vector2,id:int)->void:
	var e:=InputEventScreenDrag.new();e.position=at;e.index=id;root.push_input(e,true)
func building_point()->Vector2:
	var sprite:Sprite2D=app.world.building_sprite("chief")
	return (sprite.get_global_transform_with_canvas()*sprite.get_rect()).get_center()
func run()->void:
	app=load("res://scenes/main.tscn").instantiate();root.add_child(app);await frames()
	app.test_mode=true;app.model=GameState.new(SaveStore.new("user://hold056_%d"%Time.get_ticks_usec()));app.model.start_new()
	var state:Dictionary=app.model.state.duplicate(true);state.chief_level=1;app.model.commit(state)
	app.enter_game();await frames(8)
	app.world.player.manual_camera=true;app.world.player.zoom_at(Vector2(app.w,app.h)*.5,.8,app.model.building_position("chief"));await frames()
	var at:=building_point()
	mouse(at,MOUSE_BUTTON_LEFT,true);mouse(at,MOUSE_BUTTON_LEFT,false);await frames()
	check(app.building_menu.visible and not app.build_preview.active(),"Short click opens menu only")
	app.building_menu.move_button.pressed.emit();await frames()
	check(app.build_preview.moving_key=="chief","Menu move still works by click")
	app.cancel_build_preview();at=building_point()
	var saved:Vector2=app.model.building_position("chief")
	mouse(at,MOUSE_BUTTON_LEFT,true);await create_timer(.75).timeout;await frames()
	check(app.gestures.moving_key=="chief" and app.build_preview.moving_key=="chief","Building long press starts direct move")
	check(not app.building_menu.visible,"Long press skips menu")
	check(app.build_preview.placement_position.distance_to(saved)<1,"Grabbing roof does not snap base to cursor")
	motion(at+Vector2(60,30));await frames()
	check(app.build_preview.placement_position.distance_to(saved)>20,"Building follows mouse drag")
	var moved:Vector2=app.build_preview.placement_position
	mouse(at+Vector2(60,30),MOUSE_BUTTON_LEFT,false);await frames()
	check(app.gestures.moving_key.is_empty() and app.build_preview.active(),"Mouse release leaves confirmation preview")
	check(app.model.building_position("chief")==saved and app.build_preview.placement_position.distance_to(moved)<1,"Release does not commit or jump")
	app.cancel_build_preview();at=building_point()
	touch(at,0,true);await create_timer(.75).timeout;await frames()
	check(app.gestures.moving_key=="chief","Building long touch starts direct move")
	drag_touch(at+Vector2(-50,25),0);await frames()
	check(app.build_preview.placement_position.distance_to(saved)>20,"Touch drag follows building")
	touch(at+Vector2(-50,25),0,false);await frames()
	check(app.gestures.touches.is_empty() and not app.gestures.blocked and app.build_preview.active(),"Touch release clears ownership without placement tap")
	app.cancel_build_preview();at=building_point()
	touch(at,0,true);touch(at+Vector2(60,0),1,true);await create_timer(.75).timeout;await frames()
	check(app.gestures.moving_key.is_empty() and not app.build_preview.active(),"Pinch prevents long-touch activation")
	touch(at,0,false);touch(at+Vector2(60,0),1,false);await frames()
	at=building_point();touch(at,0,true);await create_timer(.75).timeout;await frames()
	touch(at+Vector2(70,0),1,true);await frames()
	check(app.gestures.moving_key.is_empty() and app.gestures.pinching,"Second finger transfers active drag to pinch")
	touch(at,0,false);touch(at+Vector2(70,0),1,false);await frames();app.cancel_build_preview()
	at=building_point();mouse(at,MOUSE_BUTTON_LEFT,true);await create_timer(.75).timeout;await frames()
	app._notification(Node.NOTIFICATION_APPLICATION_PAUSED);await frames()
	check(app.gestures.moving_key.is_empty() and not app.build_preview.active(),"Pause clears building drag")
	app._notification(Node.NOTIFICATION_APPLICATION_RESUMED);await frames()
	check(app.model.building_position("chief")==saved,"All cancelled previews preserve save")
	print(JSON.stringify({"checks":checks,"failures":failures,"touch":"synthetic Windows touch events, not Android hardware"}))
	app.queue_free();await frames();quit(0 if failures.is_empty() else 1)
